# Entity: product

main: kit: entity: product: {

  alias: field: {}

  fields: {
    brand: {
      h: "Brand"
      n: "brand"
      r: false
      sh: "Brand name of the product"
      t: "`$STRING`"
    }
    category: {
      h: "Category"
      n: "category"
      r: false
      sh: "Product category"
      t: "`$STRING`"
    }
    createdAt: {
      fo: "date-time"
      h: "Created At"
      n: "createdAt"
      r: false
      sh: "Product creation timestamp"
      t: "`$STRING`"
    }
    description: {
      h: "Description"
      n: "description"
      r: false
      sh: "Detailed description of the product"
      t: "`$STRING`"
    }
    id: {
      fo: "int64"
      h: "Id"
      n: "id"
      r: false
      sh: "Unique identifier for the product"
      t: "`$INTEGER`"
    }
    image: {
      fo: "uri"
      h: "Image"
      n: "image"
      r: false
      sh: "URL to product image"
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "Name of the product"
      t: "`$STRING`"
    }
    price: {
      fo: "float"
      h: "Price"
      n: "price"
      r: false
      sh: "Price of the product in USD"
      t: "`$NUMBER`"
    }
    rating: {
      fo: "float"
      h: "Rating"
      n: "rating"
      r: false
      sh: "Average product rating (0-5)"
      t: "`$NUMBER`"
    }
    stock: {
      h: "Stock"
      n: "stock"
      r: false
      sh: "Available stock quantity"
      t: "`$INTEGER`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "product"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /products"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "category"
                or: "category"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 10
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/products"
          q: {
            exist: [
              "category"
              "limit"
              "page"
            ]
          }
          s: [
            {
              lit: "products"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
