# Guide

guide: {
  metrics: count: entity: 2
  metrics: count: path: 3
  metrics: count: method: 3

  entity: product: {
    path: "/products": {
      op: list: method: *GET
    }
  }

  entity: user: {
    path: "/users": {
      op: list: method: *GET
    }
    path: "/users/{id}": {
      op: load: method: *GET
    }
  }

}